# 目标硬件配置：高通 IPQ60xx / 京东云亚瑟 AX1800 Pro (RE-SS-01)
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
# 注意：设备名只有 jdcloud_re-ss-01；不存在 jdcloud_ax1800-pro 这个设备符号
# （曾误写，会被 defconfig 静默丢弃），AX1800 Pro 是它的商品名。
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y

# 镜像与分区配置 (针对 U-Boot 大分区优化)
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_PARTSIZE=512

# 基础系统与无线驱动 (ath11k WiFi 6 及原厂硬件校准 BDF)
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_ath11k-firmware-ipq6018=y
CONFIG_PACKAGE_ipq-wifi-jdcloud_re-ss-01=y
# wpad 不在此写死变体：各源码树的默认变体不同（官方 mbedtls / ImmortalWrt 与
# LiBwrt 为 openssl），由目标默认包提供；写死 wolfssl 在 25.12 已不存在、
# 只会被静默丢弃，写死其它变体则可能与默认包冲突。
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_cpufreq=y

# NSS 硬件转发加速 (卸载 CPU 压力，满血千兆，降低功耗与内存抖动)
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-nft-offload=y

# Web 管理界面 (原生 LuCI + 中文语言包)
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_rpcd=y

# 官方推荐现代主题：Argon 及配置插件
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# 存储与大分区管理工具 (支持 eMMC 格式化与挂载，方便后续安装插件)
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_fdisk=y

# 512MB RAM 内存优化核心套件：zram 压缩交换空间
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-zram=y

# 透明代理 (nikki/momo) 必备内核模块
# 自编译 NSS 内核的 vermagic 与官方软件源不一致，kmod 无法事后安装，必须烘焙进固件
# 内存代价约 150KB，可忽略；不装则 nikki 的 TUN/TPROXY 无法工作
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_kmod-inet-diag=y
# curl 做 HTTPS 需要的 CA 证书包（nikki 拉订阅用，userspace，可烘焙省事）
CONFIG_PACKAGE_ca-bundle=y

# 核心网络基础工具
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y

# ========================================================
# 斩除一切臃肿插件，确保系统极简、纯净、开机极低内存占用
# ========================================================
# CONFIG_PACKAGE_docker is not set
# CONFIG_PACKAGE_dockerd is not set
# CONFIG_PACKAGE_docker-compose is not set
# CONFIG_PACKAGE_luci-app-dockerman is not set
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# CONFIG_PACKAGE_luci-app-samba4 is not set
# CONFIG_PACKAGE_samba4-server is not set
# CONFIG_PACKAGE_luci-app-aria2 is not set
# CONFIG_PACKAGE_luci-app-transmission is not set
# CONFIG_PACKAGE_luci-app-adguardhome is not set
# CONFIG_PACKAGE_luci-app-netdata is not set
# CONFIG_PACKAGE_luci-app-store is not set
# CONFIG_PACKAGE_luci-app-lucky is not set
# CONFIG_PACKAGE_luci-app-zerotier is not set
# CONFIG_PACKAGE_luci-app-ttyd is not set
# CONFIG_PACKAGE_luci-app-filebrowser is not set
# CONFIG_PACKAGE_luci-app-diskman is not set
